table 'Data Quality Results'
	lineageTag: 998b3e54-54c9-4f7e-9c14-77d36c75e7b4

	/// D77, D119. The latest pipeline run that has check results, ignoring report filters.
	measure 'Latest Check Batch' = CALCULATE ( MAX ( 'Data Quality Results'[batch_id] ), REMOVEFILTERS () )
		formatString: 0
		displayFolder: Data Quality
		lineageTag: 742798a7-f61d-4906-af3a-ea0b295ba5ed

	/// D119. Checks with status Pass in the latest run that has check results.
	measure 'Checks Passed' =
			VAR LatestBatch = CALCULATE ( MAX ( 'Data Quality Results'[batch_id] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Data Quality Results' ),
			        'Data Quality Results'[batch_id] = LatestBatch,
			        'Data Quality Results'[Status] = "Pass"
			    ) + 0
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: daf4640d-24c5-424c-a085-3c9448cd4b9f

	/// D119. Warning checks outside their threshold (status Warn) in the latest run that has check results.
	measure 'Checks Warned' =
			VAR LatestBatch = CALCULATE ( MAX ( 'Data Quality Results'[batch_id] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Data Quality Results' ),
			        'Data Quality Results'[batch_id] = LatestBatch,
			        'Data Quality Results'[Status] = "Warn"
			    ) + 0
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: a6f7f5b0-a617-4883-9d0c-97ff461ebe99

	/// D77, D118. Error checks that failed (status Fail) in the latest run that has check results; any failure rolls the run back.
	measure 'Checks Failed' =
			VAR LatestBatch = CALCULATE ( MAX ( 'Data Quality Results'[batch_id] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Data Quality Results' ),
			        'Data Quality Results'[batch_id] = LatestBatch,
			        'Data Quality Results'[Status] = "Fail"
			    ) + 0
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: a458359b-5578-44b9-bb41-fbfb575d9604

	/// Visual filter helper: 1 for rows of the latest run that has check results, otherwise 0.
	measure 'Is Latest Check Batch' =
			VAR LatestBatch = CALCULATE ( MAX ( 'Data Quality Results'[batch_id] ), REMOVEFILTERS () )
			RETURN
			    IF ( MAX ( 'Data Quality Results'[batch_id] ) = LatestBatch, 1, 0 )
		formatString: 0
		isHidden
		displayFolder: Data Quality
		lineageTag: f46a04a9-5015-49c6-a2a3-ef84684667d0

