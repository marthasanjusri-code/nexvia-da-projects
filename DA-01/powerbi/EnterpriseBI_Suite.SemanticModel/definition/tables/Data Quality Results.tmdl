	partition 'Data Quality Results' = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Results = Source{[Schema = "etl", Item = "dq_result"]}[Data],
				    Kept = Table.SelectColumns(Results, {"dq_id", "batch_id", "check_name", "severity", "measured_value",
				                                         "expected_value", "status", "details", "checked_at"}),
				    Checks = Table.SelectColumns(Source{[Schema = "etl", Item = "dq_check"]}[Data], {"check_code", "rule_type", "decision"}),
				    WithCode = Table.AddColumn(Kept, "check_code", each Text.Start([check_name], 3), type text),
				    Joined = Table.NestedJoin(WithCode, {"check_code"}, Checks, {"check_code"}, "Check", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "Check", {"rule_type", "decision"}),
				    Typed = Table.TransformColumnTypes(Expanded, {
				        {"dq_id", Int64.Type}, {"batch_id", Int64.Type}, {"check_name", type text}, {"severity", type text},
				        {"measured_value", Currency.Type}, {"expected_value", type text}, {"status", type text},
				        {"details", type text}, {"checked_at", type datetime}, {"check_code", type text},
				        {"rule_type", type text}, {"decision", type text}}),
				    Renamed = Table.RenameColumns(Typed, {
				        {"check_name", "Check"}, {"severity", "Severity"}, {"measured_value", "Measured Value"},
				        {"expected_value", "Expected"}, {"status", "Status"}, {"details", "Details"},
				        {"checked_at", "Checked At"}, {"check_code", "Check Code"}, {"rule_type", "Rule"}, {"decision", "Decision"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

