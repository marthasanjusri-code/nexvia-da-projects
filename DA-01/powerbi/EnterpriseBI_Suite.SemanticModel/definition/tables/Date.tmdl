	partition Date = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Data = Source{[Schema = "dw", Item = "dim_date"]}[Data],
				
				    // B: keep only these columns, by name. Relationship and audit columns are dropped;
				    // if one of these is ever missing in SQL, the refresh fails with a clear error.
				    Kept = Table.SelectColumns(Data, {
				        "date_key", "full_date", "day_of_month", "day_name", "day_short", "day_of_week",
				        "is_weekend", "iso_week", "iso_year", "month_number", "month_name", "month_short",
				        "year_month", "year_month_number", "month_start_date", "month_end_date", "is_month_end",
				        "quarter", "quarter_label", "year_quarter", "year", "fiscal_year", "fiscal_year_label",
				        "fiscal_quarter", "fiscal_month", "fiscal_year_quarter",
				        "quota_period_start", "quota_period_end", "quota_period_label"}),
				
				    // C: types from the SQL column types
				    Typed = Table.TransformColumnTypes(Kept, {
				        {"date_key", Int64.Type}, {"full_date", type date}, {"day_of_month", Int64.Type},
				        {"day_name", type text}, {"day_short", type text}, {"day_of_week", Int64.Type},
				        {"is_weekend", type logical}, {"iso_week", Int64.Type}, {"iso_year", Int64.Type},
				        {"month_number", Int64.Type}, {"month_name", type text}, {"month_short", type text},
				        {"year_month", type text}, {"year_month_number", Int64.Type},
				        {"month_start_date", type date}, {"month_end_date", type date}, {"is_month_end", type logical},
				        {"quarter", Int64.Type}, {"quarter_label", type text}, {"year_quarter", type text},
				        {"year", Int64.Type}, {"fiscal_year", Int64.Type}, {"fiscal_year_label", type text},
				        {"fiscal_quarter", Int64.Type}, {"fiscal_month", Int64.Type}, {"fiscal_year_quarter", type text},
				        {"quota_period_start", type date}, {"quota_period_end", type date}, {"quota_period_label", type text}}),
				
				    // E: readable names; the key keeps its technical name (it will be hidden)
				    Renamed = Table.RenameColumns(Typed, {
				        {"full_date", "Date"}, {"day_of_month", "Day of Month"}, {"day_name", "Day Name"},
				        {"day_short", "Day Short"}, {"day_of_week", "Day of Week"}, {"is_weekend", "Is Weekend"},
				        {"iso_week", "ISO Week"}, {"iso_year", "ISO Year"}, {"month_number", "Month Number"},
				        {"month_name", "Month Name"}, {"month_short", "Month Short"}, {"year_month", "Year Month"},
				        {"year_month_number", "Year Month Number"}, {"month_start_date", "Month Start Date"},
				        {"month_end_date", "Month End Date"}, {"is_month_end", "Is Month End"},
				        {"quarter", "Quarter"}, {"quarter_label", "Quarter Label"}, {"year_quarter", "Year Quarter"},
				        {"year", "Year"}, {"fiscal_year", "Fiscal Year"}, {"fiscal_year_label", "Fiscal Year Label"},
				        {"fiscal_quarter", "Fiscal Quarter"}, {"fiscal_month", "Fiscal Month"},
				        {"fiscal_year_quarter", "Fiscal Year Quarter"}, {"quota_period_start", "Quota Period Start"},
				        {"quota_period_end", "Quota Period End"}, {"quota_period_label", "Quota Period Label"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

