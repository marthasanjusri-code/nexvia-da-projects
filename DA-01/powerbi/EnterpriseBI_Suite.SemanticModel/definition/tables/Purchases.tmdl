table Purchases
	lineageTag: a160a159-b2cf-4043-b5e0-e423e6b3af1f

	/// Purchases "as of" date (D24, decision 2): the last purchase order date, ignoring report filters.
	measure 'Purchases As Of Date' =
			VAR AsOfKey = CALCULATE ( MAX ( Purchases[order_date_key] ), REMOVEFILTERS () )
			RETURN
			    LOOKUPVALUE ( 'Date'[Date], 'Date'[date_key], AsOfKey )
		formatString: yyyy-mm-dd
		displayFolder: As Of
		lineageTag: b87ff150-f092-46b8-913e-128c7a3cc933

	/// P1 (D42). Accepted goods value (stocked quantity x order price), all order statuses.
	measure Spend = SUM ( Purchases[Accepted Value] )
		formatString: \$#,0
		displayFolder: Spend
		lineageTag: 6b1d9fac-28b5-4a70-872d-6c195f2edf76

	/// P2. Ordered value of the purchase order lines in context.
	measure 'Purchase Order Value' = SUM ( Purchases[Ordered Value] )
		formatString: \$#,0
		displayFolder: Orders
		lineageTag: fe580447-0555-4db5-8ae6-f13e7bad553f

	/// P2. Purchase order lines.
	measure 'PO Lines' = COUNTROWS ( Purchases )
		formatString: #,0
		displayFolder: Orders
		lineageTag: c0e275eb-6ad4-4e4c-9301-1c4251a68742

	/// P2. Distinct purchase orders.
	measure 'Purchase Orders' = DISTINCTCOUNT ( Purchases[purchase_order_id] )
		formatString: #,0
		displayFolder: Orders
		lineageTag: 428f075c-1137-41f9-8df4-892469731339

	/// P3 (D43, D45). Lines on time, in full and with no rejects / lines; only lines with a valid due date on or before the purchases as-of date.
	measure 'OTIF %' =
			VAR AsOfKey = CALCULATE ( MAX ( Purchases[order_date_key] ), REMOVEFILTERS () )
			VAR DueLines =
			    FILTER (
			        Purchases,
			        Purchases[Is Due Date Invalid] = FALSE ()
			            && Purchases[due_date_key] <= AsOfKey
			    )
			RETURN
			    DIVIDE (
			        COUNTROWS (
			            FILTER (
			                DueLines,
			                NOT ISBLANK ( Purchases[ship_date_key] )
			                    && Purchases[ship_date_key] <= Purchases[due_date_key]
			                    && Purchases[Received Quantity] = Purchases[Order Quantity]
			                    && Purchases[Rejected Quantity] = 0
			            )
			        ),
			        COUNTROWS ( DueLines )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Vendor Quality
		lineageTag: c8d93bac-4362-4a13-9c22-8241c5c89934

	/// P3 (D43). Received / ordered units on the same lines as OTIF.
	measure 'Unit Fill Rate %' =
			VAR AsOfKey = CALCULATE ( MAX ( Purchases[order_date_key] ), REMOVEFILTERS () )
			VAR DueLines =
			    FILTER (
			        Purchases,
			        Purchases[Is Due Date Invalid] = FALSE ()
			            && Purchases[due_date_key] <= AsOfKey
			    )
			RETURN
			    DIVIDE ( SUMX ( DueLines, Purchases[Received Quantity] ), SUMX ( DueLines, Purchases[Order Quantity] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Vendor Quality
		lineageTag: 4460d149-61d3-40d2-a206-3358e7e9e4f9

	/// P3 (D43). Rejected / received units on the same lines as OTIF.
	measure 'Rejection %' =
			VAR AsOfKey = CALCULATE ( MAX ( Purchases[order_date_key] ), REMOVEFILTERS () )
			VAR DueLines =
			    FILTER (
			        Purchases,
			        Purchases[Is Due Date Invalid] = FALSE ()
			            && Purchases[due_date_key] <= AsOfKey
			    )
			RETURN
			    DIVIDE ( SUMX ( DueLines, Purchases[Rejected Quantity] ), SUMX ( DueLines, Purchases[Received Quantity] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Vendor Quality
		lineageTag: 104cf570-6d6f-4cbe-838e-35b13ea61de5

	/// P3 (D18: hidden, always 100%). Lines delivered by their due date / lines.
	measure 'Vendor On-time %' =
			VAR AsOfKey = CALCULATE ( MAX ( Purchases[order_date_key] ), REMOVEFILTERS () )
			VAR DueLines =
			    FILTER (
			        Purchases,
			        Purchases[Is Due Date Invalid] = FALSE ()
			            && Purchases[due_date_key] <= AsOfKey
			    )
			RETURN
			    DIVIDE (
			        COUNTROWS (
			            FILTER (
			                DueLines,
			                NOT ISBLANK ( Purchases[ship_date_key] )
			                    && Purchases[ship_date_key] <= Purchases[due_date_key]
			            )
			        ),
			        COUNTROWS ( DueLines )
			    )
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Vendor Quality
		lineageTag: 5c9b69ad-4c1c-4cf3-b523-a4bd49feb07f

	/// P8 (D51, P-a). On-order units: ordered minus received on Approved purchase order lines, overdue lines included (standard inventory position: approved, open orders not yet received). Current figure: date filters are ignored. Pending orders are not yet approved; Complete and Rejected orders are closed.
	measure 'Open Purchase Quantity' =
			CALCULATE (
			    SUMX (
			        FILTER (
			            Purchases,
			            Purchases[PO Status] = "Approved"
			                && Purchases[Received Quantity] < Purchases[Order Quantity]
			        ),
			        Purchases[Order Quantity] - Purchases[Received Quantity]
			    ),
			    REMOVEFILTERS ( 'Date' )
			) + 0
		formatString: #,0
		displayFolder: Orders
		lineageTag: 8ab935ec-4a4b-44b0-8b64-da68360d385e

	/// P8 (P-a). The part of Open Purchase Quantity already past its due date at the purchases as-of date: overdue orders to chase with the vendor.
	measure 'Overdue Open Quantity' =
			VAR AsOfKey = CALCULATE ( MAX ( Purchases[order_date_key] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE (
			        SUMX (
			            FILTER (
			                Purchases,
			                Purchases[PO Status] = "Approved"
			                    && Purchases[Received Quantity] < Purchases[Order Quantity]
			                    && Purchases[due_date_key] <= AsOfKey
			            ),
			            Purchases[Order Quantity] - Purchases[Received Quantity]
			        ),
			        REMOVEFILTERS ( 'Date' )
			    ) + 0
		formatString: #,0
		displayFolder: Orders
		lineageTag: ecbd4353-90c7-47e2-a825-0e71a4980204

	measure 'Purchasing Restricted Message' =
			
			IF (
			    ISBLANK ( CALCULATE ( COUNTROWS ( Purchases ), REMOVEFILTERS () ) ),
			    "Purchasing figures are restricted to executives. Stock figures are shown.",
			    ""
			)
		lineageTag: db1a49c0-f7f2-46fc-96b4-0e3318db3d41

