	partition Purchases = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Data = Source{[Schema = "dw", Item = "fact_purchase"]}[Data],
				    Kept = Table.SelectColumns(Data, {"purchase_order_line_id", "purchase_order_id", "order_date_key", "due_date_key", "ship_date_key", "product_key", "vendor_key", "buyer_key", "ship_method_key", "po_status", "order_qty", "received_qty", "rejected_qty", "stocked_qty", "unit_price", "ordered_value", "accepted_value", "rejected_value", "short_delivered_value", "freight_allocated", "promised_lead_days", "is_due_date_invalid", "batch_id", "loaded_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"purchase_order_line_id", Int64.Type}, {"purchase_order_id", Int64.Type}, {"order_date_key", Int64.Type}, {"due_date_key", Int64.Type}, {"ship_date_key", Int64.Type}, {"product_key", Int64.Type}, {"vendor_key", Int64.Type}, {"buyer_key", Int64.Type}, {"ship_method_key", Int64.Type}, {"po_status", type text}, {"order_qty", Int64.Type}, {"received_qty", Currency.Type}, {"rejected_qty", Currency.Type}, {"stocked_qty", Currency.Type}, {"unit_price", Currency.Type}, {"ordered_value", Currency.Type}, {"accepted_value", Currency.Type}, {"rejected_value", Currency.Type}, {"short_delivered_value", Currency.Type}, {"freight_allocated", Currency.Type}, {"promised_lead_days", Int64.Type}, {"is_due_date_invalid", type logical}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"po_status", "PO Status"}, {"order_qty", "Order Quantity"}, {"received_qty", "Received Quantity"}, {"rejected_qty", "Rejected Quantity"}, {"stocked_qty", "Stocked Quantity"}, {"unit_price", "Unit Price"}, {"ordered_value", "Ordered Value"}, {"accepted_value", "Accepted Value"}, {"rejected_value", "Rejected Value"}, {"short_delivered_value", "Short Delivered Value"}, {"freight_allocated", "Freight Allocated"}, {"promised_lead_days", "Promised Lead Days"}, {"is_due_date_invalid", "Is Due Date Invalid"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

