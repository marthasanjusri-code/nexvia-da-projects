	partition Finance = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Data = Source{[Schema = "dw", Item = "fact_finance"]}[Data],
				    Kept = Table.SelectColumns(Data, {"finance_id", "period_date_key", "organization_key", "finance_department_group_key", "account_key", "scenario_key", "entry_type", "source_date", "currency_code", "amount_local", "exchange_rate", "amount_usd", "batch_id", "loaded_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"finance_id", Int64.Type}, {"period_date_key", Int64.Type}, {"organization_key", Int64.Type}, {"finance_department_group_key", Int64.Type}, {"account_key", Int64.Type}, {"scenario_key", Int64.Type}, {"entry_type", type text}, {"source_date", type date}, {"currency_code", type text}, {"amount_local", Currency.Type}, {"exchange_rate", type number}, {"amount_usd", Currency.Type}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"entry_type", "Entry Type"}, {"source_date", "Source Date"}, {"currency_code", "Currency Code"}, {"amount_local", "Amount Local"}, {"exchange_rate", "Exchange Rate"}, {"amount_usd", "Amount USD"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

