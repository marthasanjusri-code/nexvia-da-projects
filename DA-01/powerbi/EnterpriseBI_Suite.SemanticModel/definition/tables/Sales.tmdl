	partition Sales = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Data = Source{[Schema = "dw", Item = "fact_sales"]}[Data],
				    Kept = Table.SelectColumns(Data, {"sales_order_line_id", "sales_order_id", "sales_order_number", "order_date_key", "due_date_key", "ship_date_key", "product_key", "customer_key", "salesperson_key", "territory_key", "promotion_key", "ship_method_key", "channel", "order_status", "order_qty", "unit_price", "discount_pct", "gross_amount", "discount_amount", "line_total", "unit_cost", "cost_amount", "gross_margin", "is_cost_estimated", "batch_id", "loaded_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"sales_order_line_id", Int64.Type}, {"sales_order_id", Int64.Type}, {"sales_order_number", type text}, {"order_date_key", Int64.Type}, {"due_date_key", Int64.Type}, {"ship_date_key", Int64.Type}, {"product_key", Int64.Type}, {"customer_key", Int64.Type}, {"salesperson_key", Int64.Type}, {"territory_key", Int64.Type}, {"promotion_key", Int64.Type}, {"ship_method_key", Int64.Type}, {"channel", type text}, {"order_status", type text}, {"order_qty", Int64.Type}, {"unit_price", Currency.Type}, {"discount_pct", Currency.Type}, {"gross_amount", Currency.Type}, {"discount_amount", type number}, {"line_total", type number}, {"unit_cost", Currency.Type}, {"cost_amount", Currency.Type}, {"gross_margin", type number}, {"is_cost_estimated", type logical}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"sales_order_number", "Sales Order Number"}, {"channel", "Channel"}, {"order_status", "Order Status"}, {"order_qty", "Order Quantity"}, {"unit_price", "Unit Price"}, {"discount_pct", "Discount %"}, {"gross_amount", "Gross Amount"}, {"discount_amount", "Discount Amount"}, {"line_total", "Line Total"}, {"unit_cost", "Unit Cost"}, {"cost_amount", "Cost Amount"}, {"gross_margin", "Gross Margin"}, {"is_cost_estimated", "Is Cost Estimated"}})
				in
