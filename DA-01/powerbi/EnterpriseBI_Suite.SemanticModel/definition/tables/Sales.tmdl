table Sales
	lineageTag: 6063b254-75d6-4cee-a1c9-7503b3ea3277

	/// Sales "as of" date (D24): the last order date in the whole sales module, ignoring report filters.
	measure 'Sales As Of Date' =
			VAR LastKey = CALCULATE ( MAX ( Sales[order_date_key] ), REMOVEFILTERS () )
			RETURN
			    LOOKUPVALUE ( 'Date'[Date], 'Date'[date_key], LastKey )
		formatString: yyyy-mm-dd
		displayFolder: As Of
		lineageTag: 3a44ba6d-7ce1-4dc5-8bc6-540bddfac747

	/// S1. Revenue (D14): sum of line totals, excluding Rejected and Cancelled orders.
	measure Revenue =
			CALCULATE (
			    SUM ( Sales[Line Total] ),
			    KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			)
		formatString: \$#,0
		displayFolder: Revenue
		lineageTag: acb00135-060d-4f1d-879f-c03cae3471a7

	/// S2-S4. Revenue minus cost (the column Gross Margin), with the revenue rule applied.
	measure 'Gross Profit' =
			CALCULATE (
			    SUM ( Sales[Gross Margin] ),
			    KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			)
		formatString: \$#,0
		displayFolder: Margin
		lineageTag: 7be3ef8f-5a67-4394-9538-b323a4ecc2a3

	/// S4, S6. Distinct sales orders.
	measure Orders =
			CALCULATE (
			    DISTINCTCOUNT ( Sales[sales_order_id] ),
			    KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			)
		formatString: #,0
		displayFolder: Orders and Customers
		lineageTag: cb88da04-44be-43ab-8110-7032fdf25958

	/// S6. Distinct customers with orders (D65).
	measure Customers =
			CALCULATE (
			    DISTINCTCOUNT ( Sales[customer_key] ),
			    KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			)
		formatString: #,0
		displayFolder: Orders and Customers
		lineageTag: 35578851-b814-421c-9cf4-d73348f04942

	/// S8. Sales value before discount.
	measure 'Sales Before Discount' =
			CALCULATE (
			    SUM ( Sales[Gross Amount] ),
			    KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			)
		formatString: \$#,0
		displayFolder: Discount
		lineageTag: b66de710-50cf-4b03-9628-2cebe95c5ab1

	/// S8. Discount given on the lines (D66).
	measure 'Total Discount' =
			CALCULATE (
			    SUM ( Sales[Discount Amount] ),
			    KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			)
		formatString: \$#,0
		displayFolder: Discount
		lineageTag: 827bdcf8-5d97-4172-acd4-5c590c802d40

	/// S7 (D18: hidden, always 7-8 days). Average days from order to ship, shipped lines only.
	measure 'Days to Ship' =
			AVERAGEX (
			    FILTER (
			        Sales,
			        NOT ISBLANK ( Sales[ship_date_key] )
			            && NOT Sales[Order Status] IN { "Rejected", "Cancelled" }
			    ),
			    VAR O = Sales[order_date_key]
			    VAR S = Sales[ship_date_key]
			    RETURN
			        DATEDIFF (
			            DATE ( INT ( O / 10000 ), MOD ( INT ( O / 100 ), 100 ), MOD ( O, 100 ) ),
			            DATE ( INT ( S / 10000 ), MOD ( INT ( S / 100 ), 100 ), MOD ( S, 100 ) ),
			            DAY
			        )
			)
		formatString: 0.0
		isHidden
		displayFolder: Shipping
		lineageTag: 52a98bf3-61c0-4069-a2c8-d57cdae1c69a

	/// S7 (D18: hidden). Shipped lines with ship date on or before due date / shipped lines.
	measure '% Shipped by Due Date' =
			VAR Shipped =
			    FILTER (
			        Sales,
			        NOT ISBLANK ( Sales[ship_date_key] )
			            && NOT Sales[Order Status] IN { "Rejected", "Cancelled" }
			    )
			RETURN
			    DIVIDE (
			        COUNTROWS ( FILTER ( Shipped, Sales[ship_date_key] <= Sales[due_date_key] ) ),
			        COUNTROWS ( Shipped )
			    )
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Shipping
		lineageTag: 03e15e18-e29a-4e3d-ae79-90016290956f

	/// S1. Revenue from 1 January of the year in context.
	measure 'Revenue YTD' = CALCULATE ( [Revenue], DATESYTD ( 'Date'[Date] ) )
		formatString: \$#,0
		displayFolder: Revenue
		lineageTag: 602ca7d4-a906-4549-8dd3-822879a7e494

	/// S1. Revenue of the same dates one year earlier, cut at the sales as-of date (decision 3).
	measure 'Revenue PY' =
			VAR AsOf = [Sales As Of Date]
			VAR DatesToAsOf = FILTER ( VALUES ( 'Date'[Date] ), 'Date'[Date] <= AsOf )
			RETURN
			    CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( DatesToAsOf ) )
		formatString: \$#,0
		displayFolder: Revenue
		lineageTag: 4fa74440-5269-4fc8-8172-c2a5519bd7e0

	/// never past the sales as-of month (decision 4).
	measure 'Revenue 3M Rolling Avg' =
			VAR AsOf = [Sales As Of Date]
			VAR LastMonthEnd = EOMONTH ( MIN ( MAX ( 'Date'[Date] ), AsOf ), 0 )
			RETURN
			    CALCULATE (
			        AVERAGEX ( VALUES ( 'Date'[Year Month] ), [Revenue] ),
			        DATESINPERIOD ( 'Date'[Date], LastMonthEnd, -3, MONTH )
			    )
		formatString: \$#,0
		displayFolder: Revenue
		lineageTag: a37272d2-3cb4-4176-b2ff-ba94cc21cbcf

	/// S2-S4. Gross profit / revenue of the lines that have a cost (D17).
	measure 'Gross Margin %' =
			DIVIDE (
			    [Gross Profit],
			    CALCULATE ( [Revenue], KEEPFILTERS ( NOT ISBLANK ( Sales[Gross Margin] ) ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Margin
		lineageTag: de3bc689-0f3e-4e50-8894-e5a877ddcbc9

	/// S6. Revenue per order.
	measure 'Average Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: \$#,0.00
		displayFolder: Orders and Customers
		lineageTag: 129bab0b-00fe-4aa4-be8f-9041025e611d

	/// S8. Discount as a share of the value before discount.
	measure 'Discount Rate %' = DIVIDE ( [Total Discount], [Sales Before Discount] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Discount
		lineageTag: 76bcd72a-af93-435c-aeaf-aa5bb20744b4

	/// S1. Previous-year YTD on the same dates.
	measure 'Revenue YTD PY' = CALCULATE ( [Revenue PY], DATESYTD ( 'Date'[Date] ) )
		formatString: \$#,0
		displayFolder: Revenue
		lineageTag: e79c1551-1eb7-4dfd-ad5c-01adb9d6f9ac

	/// S1. Growth against the same dates one year earlier.
	measure 'Revenue YoY %' = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Revenue
		lineageTag: 83a790ff-fb21-4c8b-b291-0f6159b6873e

	/// E. Sales revenue / average headcount of the period (data_model.md section 6, D57).
	measure 'Revenue per Employee' = DIVIDE ( [Revenue], [Average Headcount] )
		formatString: \$#,0
		displayFolder: Executive
		lineageTag: b3586bb1-dd9f-4730-83e4-5fe148d6387e

