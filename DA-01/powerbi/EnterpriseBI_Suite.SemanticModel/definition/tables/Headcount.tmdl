table Headcount
	lineageTag: 32430567-83e1-493f-b21d-a11593612ec1

	/// HR "as of" date (D24): the last headcount month-end, ignoring report filters.
	measure 'HR As Of Date' =
			VAR LastKey = CALCULATE ( MAX ( Headcount[month_end_date_key] ), REMOVEFILTERS () )
			RETURN
			    LOOKUPVALUE ( 'Date'[Date], 'Date'[date_key], LastKey )
		formatString: yyyy-mm-dd
		displayFolder: As Of
		lineageTag: 753dbe05-2222-476d-9ed5-1a841a778d7e

	/// H1. Employees at the last month-end of the selection; never summed over months (D57).
	measure 'Active Headcount' =
			VAR LastKey = MAX ( Headcount[month_end_date_key] )
			RETURN
			    CALCULATE ( COUNTROWS ( Headcount ), Headcount[month_end_date_key] = LastKey )
		formatString: #,0
		displayFolder: Headcount
		lineageTag: c78d1cca-67b0-443b-896a-bb3d5c149a4a

	/// H3. Employees hired in the selected months (one row per hire, D113).
	measure Hires = CALCULATE ( COUNTROWS ( Headcount ), KEEPFILTERS ( Headcount[Is Hired This Month] = TRUE () ) )
		formatString: #,0
		displayFolder: Hiring and Tenure
		lineageTag: d3e8ea88-6ca1-4246-ae32-7753f9e55d5d

	/// H3. Average months since hire of the employees at the last month-end of the selection (current staff only).
	measure 'Average Tenure (Months)' =
			VAR LastKey = MAX ( Headcount[month_end_date_key] )
			RETURN
			    CALCULATE ( AVERAGE ( Headcount[Tenure Months] ), Headcount[month_end_date_key] = LastKey )
		formatString: 0.0
		displayFolder: Hiring and Tenure
		lineageTag: 1fb52e62-8522-4989-9395-6f570a1ca035

	/// H4 (D56, D64). Average hourly pay at the last month-end, with complementary suppression: blank below 5 employees, blank for a department when any department of its group has fewer than 5 (H-a), and blank when filtered by employee, HR attributes or shift (H-b).
	measure 'Average Pay Rate' =
			VAR LastKey = MAX ( Headcount[month_end_date_key] )
			VAR Employees =
			    CALCULATE ( COUNTROWS ( Headcount ), Headcount[month_end_date_key] = LastKey )
			VAR PersonLevel =
			    ISFILTERED ( 'Employee' ) || ISFILTERED ( 'Employee HR' ) || ISFILTERED ( 'Shift' )
			VAR GroupsInContext = VALUES ( 'Department'[Department Group] )
			VAR DepartmentsOfGroups =
			    CALCULATETABLE (
			        VALUES ( 'Department'[Department] ),
			        REMOVEFILTERS ( 'Department' ),
			        TREATAS ( GroupsInContext, 'Department'[Department Group] )
			    )
			VAR SmallestDepartment =
			    MINX (
			        FILTER (
			            ADDCOLUMNS (
			                DepartmentsOfGroups,
			                "@Employees",
			                    VAR ThisDepartment = 'Department'[Department]
			                    RETURN
			                        CALCULATE (
			                            COUNTROWS ( Headcount ),
			                            REMOVEFILTERS ( 'Department' ),
			                            'Department'[Department] = ThisDepartment,
			                            Headcount[month_end_date_key] = LastKey
			                        )
			            ),
			            [@Employees] > 0
			        ),
			        [@Employees]
			    )
			VAR DepartmentShown =
			    NOT ISFILTERED ( 'Department'[Department] ) || SmallestDepartment >= 5
			RETURN
			    IF (
			        NOT PersonLevel && Employees >= 5 && DepartmentShown,
			        CALCULATE ( AVERAGE ( Headcount[Pay Rate] ), Headcount[month_end_date_key] = LastKey )
			    )
		formatString: \$#,0.00
		displayFolder: Pay
		lineageTag: 29f70200-3851-4790-9dc8-cc0c63175bfb

	/// H5. Current vacation hours of the employees at the last month-end of the selection (from Employee HR, D62).
	measure 'Total Vacation Hours' =
			VAR LastKey = MAX ( Headcount[month_end_date_key] )
			VAR EmployeesAtMonthEnd =
			    CALCULATETABLE ( VALUES ( Headcount[employee_key] ), Headcount[month_end_date_key] = LastKey )
			RETURN
			    CALCULATE ( SUM ( 'Employee HR'[Vacation Hours] ), TREATAS ( EmployeesAtMonthEnd, 'Employee HR'[employee_key] ) )
		formatString: #,0
		displayFolder: Leave
		lineageTag: c8fd7bee-2b82-4a92-89bb-a9d6a45cd020

	/// H5. Current sick leave hours of the employees at the last month-end of the selection (from Employee HR, D62).
	measure 'Total Sick Leave Hours' =
			VAR LastKey = MAX ( Headcount[month_end_date_key] )
			VAR EmployeesAtMonthEnd =
			    CALCULATETABLE ( VALUES ( Headcount[employee_key] ), Headcount[month_end_date_key] = LastKey )
			RETURN
			    CALCULATE ( SUM ( 'Employee HR'[Sick Leave Hours] ), TREATAS ( EmployeesAtMonthEnd, 'Employee HR'[employee_key] ) )
		formatString: #,0
		displayFolder: Leave
		lineageTag: 58515e87-4d30-4859-94c3-0be69ad1daf1

	/// H1, E. Average of the month-end headcounts in the selection (D57).
	measure 'Average Headcount' = AVERAGEX ( VALUES ( Headcount[month_end_date_key] ), [Active Headcount] )
		formatString: #,0.0
		displayFolder: Headcount
		lineageTag: d5a20741-19ef-4958-b8d8-84306d383226

