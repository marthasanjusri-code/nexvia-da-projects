	partition Headcount = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Data = Source{[Schema = "dw", Item = "fact_headcount_monthly"]}[Data],
				    Kept = Table.SelectColumns(Data, {"employee_id", "month_end_date_key", "employee_key", "department_key", "shift_key", "pay_rate", "pay_frequency", "age_at_month_end", "tenure_months", "is_hired_this_month", "batch_id", "loaded_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"employee_id", Int64.Type}, {"month_end_date_key", Int64.Type}, {"employee_key", Int64.Type}, {"department_key", Int64.Type}, {"shift_key", Int64.Type}, {"pay_rate", Currency.Type}, {"pay_frequency", Int64.Type}, {"age_at_month_end", Int64.Type}, {"tenure_months", Int64.Type}, {"is_hired_this_month", type logical}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"pay_rate", "Pay Rate"}, {"pay_frequency", "Pay Frequency"}, {"age_at_month_end", "Age at Month End"}, {"tenure_months", "Tenure Months"}, {"is_hired_this_month", "Is Hired This Month"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

