				    Data = Source{[Schema = "dw", Item = "fact_sales_quota"]}[Data],
				    Kept = Table.SelectColumns(Data, {"salesperson_id", "quota_date_key", "salesperson_key", "territory_key", "territory_source", "quota_period_start", "quota_period_end", "sales_quota", "batch_id", "loaded_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"salesperson_id", Int64.Type}, {"quota_date_key", Int64.Type}, {"salesperson_key", Int64.Type}, {"territory_key", Int64.Type}, {"territory_source", type text}, {"quota_period_start", type date}, {"quota_period_end", type date}, {"sales_quota", Currency.Type}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"territory_source", "Territory Source"}, {"quota_period_start", "Quota Period Start"}, {"quota_period_end", "Quota Period End"}, {"sales_quota", "Sales Quota"}})
