table 'Sales Quota'
	lineageTag: 52b9bdda-dd36-4a5c-8206-78db19115457

	/// S5, S9. Sales quota of the quota rows in context.
	measure Quota = SUM ( 'Sales Quota'[Sales Quota] )
		formatString: \$#,0
		displayFolder: Quota
		lineageTag: b02d45f4-6589-4270-ab01-c9a1554032bb

	/// can be a region-level row (D61) while its sales sit in real territories.
	measure 'Revenue in Quota Periods' =
			SUMX (
			    'Sales Quota',
			    VAR Person = 'Sales Quota'[salesperson_key]
			    VAR PeriodStart = 'Sales Quota'[Quota Period Start]
			    VAR PeriodEnd = 'Sales Quota'[Quota Period End]
			    RETURN
			        CALCULATE (
			            [Revenue],
			            REMOVEFILTERS ( 'Date' ),
			            REMOVEFILTERS ( 'Territory' ),
			            DATESBETWEEN ( 'Date'[Date], PeriodStart, PeriodEnd ),
			            TREATAS ( { Person }, Sales[salesperson_key] )
			        )
			)
		formatString: \$#,0
		displayFolder: Quota
		lineageTag: 8a832b1e-b235-4955-8538-689b51399a2b

	/// S5, S9. Revenue in quota periods / quota.
	measure 'Quota Attainment %' = DIVIDE ( [Revenue in Quota Periods], [Quota] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Quota
		lineageTag: dcb4d980-577a-456e-b7f3-ed7d531df263

