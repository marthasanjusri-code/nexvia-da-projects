table Inventory
	lineageTag: f94e869b-940e-43c7-a253-ddb0ce0f2357

	/// Inventory "as of" date (D24): the stock snapshot date.
	measure 'Inventory As Of Date' =
			VAR SnapshotKey = CALCULATE ( MAX ( Inventory[snapshot_date_key] ), REMOVEFILTERS () )
			RETURN
			    LOOKUPVALUE ( 'Date'[Date], 'Date'[date_key], SnapshotKey )
		formatString: yyyy-mm-dd
		displayFolder: As Of
		lineageTag: 0f16d777-e180-4be9-8c7b-f36e045b8d11

	/// P4. Units on hand at the snapshot; date filters are ignored because inventory is one current snapshot.
	measure 'Stock Units' = CALCULATE ( SUM ( Inventory[Quantity] ), REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Stock
		lineageTag: 5b30b865-af56-48fe-b322-de3dfe668a58

	/// P4 (D51). Units in storage locations, ready to ship.
	measure 'Available Units' =
			CALCULATE (
			    SUM ( Inventory[Quantity] ),
			    REMOVEFILTERS ( 'Date' ),
			    KEEPFILTERS ( 'Location'[Location Type] = "Storage" )
			)
		formatString: #,0
		displayFolder: Stock
		lineageTag: 0e699165-a15f-4f67-b836-aa2bd8192fb2

	/// P4 (D53). Stock value of the units with a cost; read with Stock Value Coverage %.
	measure 'Total Stock Value' = CALCULATE ( SUM ( Inventory[Stock Value] ), REMOVEFILTERS ( 'Date' ) )
		formatString: \$#,0
		displayFolder: Stock
		lineageTag: 1efcc6b7-645f-418c-8afd-36020c7776d8

	/// P4 (D53). Share of stock units that have a cost.
	measure 'Stock Value Coverage %' =
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( SUM ( Inventory[Quantity] ), KEEPFILTERS ( NOT ISBLANK ( Inventory[Unit Cost] ) ) ),
			        SUM ( Inventory[Quantity] )
			    ),
			    REMOVEFILTERS ( 'Date' )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Stock
		lineageTag: 1541c96d-5e33-4ca7-a6c7-2d9ea748dda9

	/// P4, P8 (D51). Products whose inventory position (on hand + open purchase quantity on Approved orders, P-a) is below the reorder point: Reorder now.
	measure 'Products to Reorder' =
			VAR Products =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( Inventory, 'Product'[product_key], 'Product'[Reorder Point], 'Product'[Safety Stock Level] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@Position",
			            CALCULATE ( SUM ( Inventory[Quantity] ), REMOVEFILTERS ( 'Date' ) )
			                + CALCULATE (
			                    SUMX (
			                        FILTER (
			                            Purchases,
			                            Purchases[PO Status] = "Approved"
			                                && Purchases[Received Quantity] < Purchases[Order Quantity]
			                        ),
			                        Purchases[Order Quantity] - Purchases[Received Quantity]
			                    ),
			                    REMOVEFILTERS ( 'Date' )
			                )
			    )
			RETURN
			    COUNTROWS ( FILTER ( Products, [@Position] < 'Product'[Reorder Point] ) ) + 0
		formatString: #,0
		displayFolder: Stock Status
		lineageTag: 80a560a3-7d88-4181-98e1-d45ff71dc2e1

	/// P4 (D51). Products at or above the reorder point but below safety stock: Below minimum.
	measure 'Products Below Minimum' =
			VAR Products =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( Inventory, 'Product'[product_key], 'Product'[Reorder Point], 'Product'[Safety Stock Level] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@Position",
			            CALCULATE ( SUM ( Inventory[Quantity] ), REMOVEFILTERS ( 'Date' ) )
			                + CALCULATE (
			                    SUMX (
			                        FILTER (
			                            Purchases,
			                            Purchases[PO Status] = "Approved"
			                                && Purchases[Received Quantity] < Purchases[Order Quantity]
			                        ),
			                        Purchases[Order Quantity] - Purchases[Received Quantity]
			                    ),
			                    REMOVEFILTERS ( 'Date' )
			                )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            Products,
			            [@Position] >= 'Product'[Reorder Point]
			                && [@Position] < 'Product'[Safety Stock Level]
			        )
			    ) + 0
		formatString: #,0
		displayFolder: Stock Status
		lineageTag: 205ab15b-ccdd-486c-bbe5-4d8d3c961872

	/// P4 (D51). Products at or above both limits.
	measure 'Products OK' =
			VAR Products =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE ( Inventory, 'Product'[product_key], 'Product'[Reorder Point], 'Product'[Safety Stock Level] ),
			            REMOVEFILTERS ( 'Date' )
			        ),
			        "@Position",
			            CALCULATE ( SUM ( Inventory[Quantity] ), REMOVEFILTERS ( 'Date' ) )
			                + CALCULATE (
			                    SUMX (
			                        FILTER (
			                            Purchases,
			                            Purchases[PO Status] = "Approved"
			                                && Purchases[Received Quantity] < Purchases[Order Quantity]
			                        ),
			                        Purchases[Order Quantity] - Purchases[Received Quantity]
			                    ),
			                    REMOVEFILTERS ( 'Date' )
			                )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            Products,
			            [@Position] >= 'Product'[Reorder Point]
			                && [@Position] >= 'Product'[Safety Stock Level]
			        )
			    ) + 0
		formatString: #,0
		displayFolder: Stock Status
		lineageTag: 1a9ef7ca-96a8-4964-84ac-224bb865b85c

	/// P9 (decision 5). Stock on hand / average daily units sold over the last 90 days of sales data, for products sold in that window.
	measure 'Days of Stock Cover' =
			VAR SalesLastKey = CALCULATE ( MAX ( Sales[order_date_key] ), REMOVEFILTERS () )
			VAR SalesLast = LOOKUPVALUE ( 'Date'[Date], 'Date'[date_key], SalesLastKey )
			VAR PerProduct =
			    ADDCOLUMNS (
			        VALUES ( 'Product'[product_key] ),
			        "@Units90",
			            CALCULATE (
			                SUM ( Sales[Order Quantity] ),
			                REMOVEFILTERS ( 'Date' ),
			                DATESBETWEEN ( 'Date'[Date], SalesLast - 89, SalesLast ),
			                KEEPFILTERS ( NOT Sales[Order Status] IN { "Rejected", "Cancelled" } )
			            ),
			        "@Stock", CALCULATE ( SUM ( Inventory[Quantity] ), REMOVEFILTERS ( 'Date' ) )
			    )
			VAR Sold = FILTER ( PerProduct, [@Units90] > 0 )
			RETURN
			    DIVIDE ( SUMX ( Sold, [@Stock] ), SUMX ( Sold, [@Units90] ) / 90 )
		formatString: #,0.0
		displayFolder: Stock
		lineageTag: 8316f873-68cb-4b5f-915a-c5d250711159

