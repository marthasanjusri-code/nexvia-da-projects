	partition Inventory = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "EnterpriseBI_DW"),
				    Data = Source{[Schema = "dw", Item = "fact_inventory_current"]}[Data],
				    Kept = Table.SelectColumns(Data, {"product_key", "location_key", "snapshot_date_key", "product_id", "location_id", "quantity", "unit_cost", "stock_value", "cost_source", "last_modified_date", "is_zero_stock_row", "batch_id", "loaded_at"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"product_key", Int64.Type}, {"location_key", Int64.Type}, {"snapshot_date_key", Int64.Type}, {"product_id", Int64.Type}, {"location_id", Int64.Type}, {"quantity", Int64.Type}, {"unit_cost", Currency.Type}, {"stock_value", Currency.Type}, {"cost_source", type text}, {"last_modified_date", type date}, {"is_zero_stock_row", type logical}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"quantity", "Quantity"}, {"unit_cost", "Unit Cost"}, {"stock_value", "Stock Value"}, {"cost_source", "Cost Source"}, {"last_modified_date", "Last Modified Date"}, {"is_zero_stock_row", "Is Zero Stock Row"}})
				in
				    Renamed

	annotation PBI_ResultType = Table

