table 'Work Orders'
	lineageTag: 2418c894-6b87-415c-8494-2884fe6bf542

	/// Production "as of" date (D24, decision 2): the last work order start date.
	measure 'Production As Of Date' =
			VAR LastKey = CALCULATE ( MAX ( 'Work Orders'[start_date_key] ), REMOVEFILTERS () )
			RETURN
			    LOOKUPVALUE ( 'Date'[Date], 'Date'[date_key], LastKey )
		formatString: yyyy-mm-dd
		displayFolder: As Of
		lineageTag: f4949e7b-de70-4f15-a267-ffed1845c5dc

	/// P6, P7. Work orders started in the selection (active date: start date).
	measure 'Work Orders Started' = COUNTROWS ( 'Work Orders' )
		formatString: #,0
		displayFolder: Production
		lineageTag: c5e27226-2a18-4daf-8f07-19a90408c3c1

	/// P6. Units scrapped.
	measure 'Scrapped Units' = SUM ( 'Work Orders'[Scrapped Quantity] )
		formatString: #,0
		displayFolder: Scrap
		lineageTag: 0e5fe863-bc74-48e0-910f-e5c8f5cf2167

	/// P6 (D46). Scrapped units / ordered units; the main P6 KPI.
	measure 'Scrap Rate %' = DIVIDE ( SUM ( 'Work Orders'[Scrapped Quantity] ), SUM ( 'Work Orders'[Order Quantity] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Scrap
		lineageTag: dbd1dd0e-f8af-431d-a33d-f36c5eee289c

	/// P6 (D46: hidden). Valued for only 21.4% of scrapped units.
	measure 'Total Scrap Cost' = SUM ( 'Work Orders'[Scrap Cost] )
		formatString: \$#,0
		isHidden
		displayFolder: Scrap
		lineageTag: 9ff21627-0af6-49ce-883e-089742a3f97c

	/// P7 (D47). Finished work orders finished by their due date / finished work orders.
	measure 'On-time Production %' =
			VAR Finished = FILTER ( 'Work Orders', NOT ISBLANK ( 'Work Orders'[end_date_key] ) )
			RETURN
			    DIVIDE (
			        COUNTROWS ( FILTER ( Finished, 'Work Orders'[Is Finished Late] = FALSE () ) ),
			        COUNTROWS ( Finished )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Production
		lineageTag: 67fbe2e5-b8e1-4dd9-a062-e6a91d4ae5f9

