				    Typed = Table.TransformColumnTypes(Kept, {{"work_order_id", Int64.Type}, {"start_date_key", Int64.Type}, {"end_date_key", Int64.Type}, {"due_date_key", Int64.Type}, {"product_key", Int64.Type}, {"scrap_reason_key", Int64.Type}, {"order_qty", Int64.Type}, {"stocked_qty", Int64.Type}, {"scrapped_qty", Int64.Type}, {"days_to_finish", Int64.Type}, {"days_late", Int64.Type}, {"is_finished_late", type logical}, {"unit_cost", Currency.Type}, {"scrap_cost", Currency.Type}, {"cost_source", type text}, {"batch_id", Int64.Type}, {"loaded_at", type datetime}}),
				    Renamed = Table.RenameColumns(Typed, {{"order_qty", "Order Quantity"}, {"stocked_qty", "Stocked Quantity"}, {"scrapped_qty", "Scrapped Quantity"}, {"days_to_finish", "Days to Finish"}, {"days_late", "Days Late"}, {"is_finished_late", "Is Finished Late"}, {"unit_cost", "Unit Cost"}, {"scrap_cost", "Scrap Cost"}, {"cost_source", "Cost Source"}})
